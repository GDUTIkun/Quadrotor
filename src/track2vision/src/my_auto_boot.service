[Unit]
Description=ROS 2 tracked2vision launch
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi5
Group=pi5
SupplementaryGroups=dialout
WorkingDirectory=/home/pi5/flight_ws
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/pi5
ExecStart=/home/pi5/flight_ws/src/offboard_control/scripts/mission.sh
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
